# File: docker/dev.env
# Môi trường: Development (local)

# Environment
ENVIRONMENT=dev
ASPNETCORE_ENVIRONMENT=Development
BUILD_TARGET=development

# JWT Configuration (cho testing)
Jwt__Key=dev-secret-key-1234567890-abcdefghijk
Jwt__Issuer=RecruitAI-Dev
Jwt__Audience=RecruitAI-Client-Dev

# Database
DB_PASSWORD=DevPass@8386
DB_PORT=1434
DB_NAME=RecruitDev
DB_SUFFIX=  

# API
API_PORT=5000
COMMAND=dotnet watch run --project RecruitAI.API/RecruitAI.API.csproj --urls http://0.0.0.0:8080

# Volumes - mount code để hot reload
MOUNT_SRC=./src

# Restart policy
RESTART_POLICY=no

# MSSQL Edition
MSSQL_PID=Express

#Cors
CORS_ALLOWED_ORIGINS=  