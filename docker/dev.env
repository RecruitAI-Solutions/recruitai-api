# File: docker/dev.env
# Môi trường: Development (local)

# Environment
ENVIRONMENT=dev
ASPNETCORE_ENVIRONMENT=Development
BUILD_TARGET=development

# Database
DB_PASSWORD=DevPass@8386
DB_PORT=1434
DB_NAME=RecruitDev
DB_SUFFIX=  # Không thêm suffix

# API
API_PORT=5000
COMMAND=dotnet watch run --project RecruitAI.API/RecruitAI.API.csproj --urls http://0.0.0.0:8080

# Volumes - mount code để hot reload
MOUNT_SRC=./src

# Restart policy
RESTART_POLICY=no

# MSSQL Edition
MSSQL_PID=Express

#Cors
CORS_ALLOWED_ORIGINS=  # Để trống = allow all