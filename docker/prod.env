# File: docker/prod.env
# Môi trường: Production (VPS production)

# Environment
ENVIRONMENT=prod
ASPNETCORE_ENVIRONMENT=Production
BUILD_TARGET=production  # Dùng stage production

# Database
DB_PASSWORD=Prod@StrongPassword123  # Đổi password mạnh hơn
DB_PORT=1433  # Port mặc định
DB_NAME=RecruitDev
DB_SUFFIX=  # Không suffix

# API
API_PORT=80  # Port HTTP mặc định
COMMAND=dotnet RecruitAI.API.dll  # Chạy trực tiếp

# Volumes - không mount code
MOUNT_SRC=  # Để trống

# Docker image
DOCKER_IMAGE=recruitai/recruitai-api
TAG=latest

# Restart policy
RESTART_POLICY=always

# MSSQL Edition
MSSQL_PID=Developer  # Dùng bản Developer cho production