# File: docker/prod.env
# Môi trường: Production (VPS production)

# Environment
ENVIRONMENT=prod
ASPNETCORE_ENVIRONMENT=Production
BUILD_TARGET=production  

# JWT Configuration (cho production)
Jwt__Key=thực-sự-bí-mật-không-ai-biết-32-ký-tự
Jwt__Issuer=RecruitAI-Prod
Jwt__Audience=RecruitAI-Client-Prod

Jwt__Key=thực-sự-bí-mật-không-ai-biết-32-ký-tự
Jwt__Issuer=RecruitAI-Prod
Jwt__Audience=RecruitAI-Client-Prod

# Database
DB_PASSWORD=Prod@StrongPassword123  
DB_PORT=1433  # Port mặc định
DB_NAME=RecruitDev
DB_SUFFIX=  # Không suffix

# API
API_PORT=80  # Port HTTP mặc định
COMMAND=dotnet RecruitAI.API.dll  

# Volumes - không mount code
MOUNT_SRC=  

# Docker image
DOCKER_IMAGE=recruitai/recruitai-api
TAG=latest

# Restart policy
RESTART_POLICY=always

# MSSQL Edition
MSSQL_PID=Developer  

#Cors
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com