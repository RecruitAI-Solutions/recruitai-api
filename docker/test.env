# File: docker/test.env
# Môi trường: Testing (VPS test)

# Environment
ENVIRONMENT=test
ASPNETCORE_ENVIRONMENT=Testing
BUILD_TARGET=production  # Dùng stage production

# Database
DB_PASSWORD=Test@123456
DB_PORT=1435
DB_NAME=RecruitDev
DB_SUFFIX=_Test  # Thêm suffix _Test

# API
API_PORT=5001
COMMAND=dotnet RecruitAI.API.dll  # Chạy trực tiếp, không watch

# Volumes - không mount code
MOUNT_SRC=  # Để trống

# Docker image
DOCKER_IMAGE=recruitai/recruitai-api
TAG=test-latest

# Restart policy
RESTART_POLICY=unless-stopped

# MSSQL Edition
MSSQL_PID=Express