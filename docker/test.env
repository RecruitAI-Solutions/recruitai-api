# File: docker/test.env
# Môi trường: Testing (local)

# Environment
ENVIRONMENT=test
ASPNETCORE_ENVIRONMENT=Testing
BUILD_TARGET=testing
TAG=test-latest

# Database
DB_PASSWORD=TestPass@8386
DB_PORT=1435
DB_NAME=RecruitDev
DB_SUFFIX=_Test

# API Port
API_PORT=5001

# MSSQL Edition
MSSQL_PID=Express

# JWT Configuration (cho testing)
Jwt__Key=test-secret-key-1234567890-abcdefghijk
Jwt__Issuer=RecruitAI-Testing
Jwt__Audience=RecruitAI-Client-Testing

# Connection string (tự động tạo từ các biến trên)
# ConnectionStrings__DefaultConnection sẽ được tạo tự động trong docker-compose

# Restart policy
RESTART_POLICY=unless-stopped

# Docker image
DOCKER_IMAGE=recruitai/recruitai-api

#Cors
CORS_ALLOWED_ORIGINS= 