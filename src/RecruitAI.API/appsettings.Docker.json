{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.EntityFrameworkCore": "Warning"
			}
		}
	},
	"ConnectionStrings": {
		"DefaultConnection": "Server=sqlserver;Database=RecruitDev;User Id=sa;Password=${SA_PASSWORD};MultipleActiveResultSets=true;Encrypt=false;TrustServerCertificate=true"
	},
	"Jwt": {
		"Key": "${JWT_KEY}",
		"Issuer": "RecruitAI",
		"Audience": "RecruitAI-Client",
		"ExpiryMinutes": 60,
		"RefreshTokenExpiryDays": 7
	},
	"Cors": {
		"AllowedOrigins": [ "http://localhost:3000" ]
	},
	"App": {
		"ClientUrl": "http://localhost:3000",
		"Name": "RecruitAI (Docker)"
	}
}