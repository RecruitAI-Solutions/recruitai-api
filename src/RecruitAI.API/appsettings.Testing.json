{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.EntityFrameworkCore": "Information"
			}
		},
		"WriteTo": [
			{
				"Name": "Console",
				"Args": {
					"theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
				}
			}
		]
	},
	"ConnectionStrings": {
		"DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=RecruitTest;Trusted_Connection=True;MultipleActiveResultSets=true"
	},
	"Jwt": {
		"Key": "test-secret-key-for-testing-only-1234567890",
		"AccessTokenExpiryMinutes": 5,
		"RefreshTokenExpiryDays": 1
	}
}